# Snapshot.org Committee Space IDs (governance views)

# Grants Committee Snapshot Space
SNAPSHOT_GRANTS_SPACE_ID=

# Verified Operators Committee Snapshot Space
SNAPSHOT_OPERATOR_SPACE_ID=

# Multisig Committee Snapshot Space
SNAPSHOT_MULTISIG_SPACE_ID=

# Committee Leads Snapshot Space
SNAPSHOT_LEADS_SPACE_ID=

# Delegate Score API (replaces the retired Karma API)
# Base URL of the read-only SSV Delegate Score API. The delegates page shows
# a notice instead of the leaderboard when unset.
# Example: DELEGATE_SCORE_API_URL=http://127.0.0.1:8000
DELEGATE_SCORE_API_URL=

# Mainnet RPC (Delegation module wallet features)
# Server-only: the browser reaches it through the read-only /api/rpc proxy.
# There is no public fallback. /delegation shows a notice instead of the
# wallet controls when unset.
# Example: MAINNET_RPC_URL=https://mainnet.infura.io/v3/<key>
MAINNET_RPC_URL=

# WalletConnect Cloud project ID (optional, public)
# Unset: only injected browser wallets are offered, with a console warning.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# HighSignal routes for the /delegation claim wizard (optional)
# Unset: the defaults shown. {username} is replaced with the HighSignal username.
HIGHSIGNAL_PROJECT_URL=https://app.highsignal.xyz/p/ssv/
HIGHSIGNAL_SETTINGS_URL_TEMPLATE=https://app.highsignal.xyz/settings/u/{username}

# Opt-out Score API mock (default: on)
# The Score API has no opt-out endpoint yet. While on, /delegation records
# signed opt-outs in .cache/ and shows a "Demo" banner. Set to false to forward
# them to DELEGATE_SCORE_API_URL/v1/opt-out.
OPT_OUT_MOCK=true

# The Graph API Key (Required for delegation data)
# Get a free API key at https://thegraph.com/studio/apikeys/
# Free tier: 100,000 queries/month
# This is used to query the Snapshot subgraph for delegation relationships
THEGRAPH_API_KEY=

# Delegation Source Addresses
# Comma-separated list of Ethereum addresses (DAO treasury, multisig, etc.)
# These are the addresses FROM which the DAO delegates voting power
# Anyone receiving delegation FROM these addresses will be marked as "already delegated"
# Example: SNAPSHOT_DELEGATION_SOURCE_ADDRESSES=0x1234...,0x5678...,0x9abc...
SNAPSHOT_DELEGATION_SOURCE_ADDRESSES=

# Filter delegations by specific Snapshot space
SNAPSHOT_DELEGATION_SPACE_FILTER=mainnet.ssvnetwork.eth

# DAO Calendar Configuration
# URL to the DAO's public iCal (.ics) feed for fetching governance events
# This is used to display upcoming DAO events in the timeline
DAO_CALENDAR_ICS_URL=

# AI Extraction Configuration (Optional)
# Anthropic API key for AI-powered event extraction from proposals
# Get an API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Enable/disable AI extraction feature (default: false)
AI_EXTRACTION_ENABLED=false

# Maximum budget per extraction run in USD (default: 1.00)
AI_EXTRACTION_MAX_BUDGET=1.00

# Model to use for extraction (haiku is cost-efficient, default: haiku)
AI_EXTRACTION_MODEL=haiku

# AI Proposal Summary & Q&A
# Both features reuse ANTHROPIC_API_KEY, AI_EXTRACTION_ENABLED and
# AI_EXTRACTION_MODEL above — set those and they turn on together.

# Max questions per client per 10 minutes on /api/proposal-qna (default: 10)
# Guards the cost of a free-form-input endpoint. In-memory and per-instance,
# so it resets on redeploy and is not shared across serverless instances.
AI_QNA_RATE_LIMIT_PER_WINDOW=10
